+
+static inline UINT WINAPI GetDpiForWindow(HWND hwnd)
+{
+    using GetDpiForWindowFunc = UINT (WINAPI *)(HWND);
+    static const auto getDpiForWindow = []() -> GetDpiForWindowFunc {
+        HMODULE user32 = GetModuleHandleW(L"user32.dll");
+        return user32 ? reinterpret_cast<GetDpiForWindowFunc>(
+                GetProcAddress(user32, "GetDpiForWindow")) : nullptr;
+    }();
+
+    if (getDpiForWindow)
+        return getDpiForWindow(hwnd);
+
+    HDC hdc = GetDC(hwnd);
+    const UINT dpi = hdc ? UINT(GetDeviceCaps(hdc, LOGPIXELSX)) : 96;
+    if (hdc)
+        ReleaseDC(hwnd, hdc);
+    return dpi ? dpi : 96;
+}
+
+static inline BOOL WINAPI AdjustWindowRectExForDpi(LPRECT lpRect, DWORD dwStyle, BOOL bMenu,
